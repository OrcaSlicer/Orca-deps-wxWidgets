# Build defaults for OrcaSlicer's dependency build. Cache values set here take
# precedence over the defaults in options.cmake; -D on the command line still wins.

if(MSVC AND CMAKE_C_COMPILER_ID STREQUAL "Clang")
    set(wxBUILD_PRECOMP OFF CACHE STRING "")
else()
    set(wxBUILD_PRECOMP ON CACHE STRING "")
endif()

if(MSVC)
    set(wxUSE_WEBVIEW_EDGE ON CACHE BOOL "")
else()
    set(wxUSE_WEBVIEW_EDGE OFF CACHE BOOL "")
endif()

set(wxBUILD_DEBUG_LEVEL 0 CACHE STRING "")
set(wxBUILD_SAMPLES OFF CACHE STRING "")
set(wxUSE_AUI ON CACHE BOOL "")
set(wxUSE_DETECT_SM OFF CACHE BOOL "")
set(wxUSE_GLCANVAS_EGL ON CACHE BOOL "")
set(wxUSE_LIBJPEG sys CACHE STRING "")
set(wxUSE_LIBPNG sys CACHE STRING "")
set(wxUSE_LIBSDL OFF CACHE BOOL "")
set(wxUSE_LIBTIFF OFF CACHE STRING "")
set(wxUSE_LIBWEBP builtin CACHE STRING "")
set(wxUSE_EXPAT sys CACHE STRING "")
set(wxUSE_MEDIACTRL ON CACHE BOOL "")
set(wxUSE_NANOSVG OFF CACHE STRING "")
set(wxUSE_OPENGL ON CACHE BOOL "")
set(wxUSE_PRIVATE_FONTS ON CACHE BOOL "")
set(wxUSE_REGEX builtin CACHE STRING "")
set(wxUSE_STC OFF CACHE BOOL "")
set(wxUSE_WEBREQUEST ON CACHE BOOL "")
set(wxUSE_WEBVIEW ON CACHE BOOL "")
set(wxUSE_WEBVIEW_IE OFF CACHE BOOL "")
set(wxUSE_XTEST OFF CACHE BOOL "")
set(wxUSE_ZLIB sys CACHE STRING "")
